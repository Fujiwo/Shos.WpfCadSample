<Window x:Class="Shos.WpfCadSample.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Shos.WpfCadSample.ViewModels;assembly=Shos.WpfCadSample.Core"
        xmlns:views="clr-namespace:Shos.WpfCadSample.Views"
        xmlns:behaviors="clr-namespace:Shos.WpfCadSample.Views.Behaviors"
        xmlns:settings="clr-namespace:Shos.WpfCadSample.Settings;assembly=Shos.WpfCadSample.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        DataContext="{Binding MainViewModel, Source={StaticResource CompositionRoot}}"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding Title}" Width="1000" Height="700"
        behaviors:WindowClosingBehavior.ViewModel="{Binding}"
        behaviors:WindowPlacementBehavior.Placement="{Binding MainPlacement}"
        behaviors:WindowPlacementBehavior.DefaultPlacement="{Binding MainWindow, Source={x:Static settings:AppSettings.Default}}"
        behaviors:Shortcuts.Source="{StaticResource MenuShortcuts}"
        behaviors:CommandEvents.Activated="{Binding RefreshClipboardStateCommand}">
    <!-- ウィンドウの振る舞い（上の属性）：WindowClosingBehavior は閉じる前の保存確認、WindowPlacementBehavior は配置の復元と保存、
         Shortcuts.Source はメニューのショートカット、CommandEvents.Activated は Paste の有効状態の更新 -->
    <!-- 属性ウィンドウ（モードレス）。メインウィンドウの表示後に、その所有者にする -->
    <behaviors:WindowVisibilityBehavior.OwnedWindow>
        <views:PropertiesWindow />
    </behaviors:WindowVisibilityBehavior.OwnedWindow>

    <!-- 描画領域の操作のキー（仕様 5.2、5.6）。メニューのショートカットは Shortcuts.Source -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Drawing.CancelCommand}" />
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding Drawing.ScrollCommand}" CommandParameter="{x:Static viewModels:ScrollDirection.Left}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding Drawing.ScrollCommand}" CommandParameter="{x:Static viewModels:ScrollDirection.Right}" />
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding Drawing.ScrollCommand}" CommandParameter="{x:Static viewModels:ScrollDirection.Up}" />
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding Drawing.ScrollCommand}" CommandParameter="{x:Static viewModels:ScrollDirection.Down}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ツールボタン：常にいずれか 1 つが選ばれた状態（仕様 4.2）。選択はコマンドで変え、表示は CurrentTool に従う。
             ボタンごとのツールは ToolSelection.Tool で指定する（CommandParameter と IsChecked の比較に使う） -->
        <Style x:Key="ToolButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignToolRadioButton}">
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Command" Value="{Binding Drawing.SelectToolCommand}" />
            <Setter Property="behaviors:ToolSelection.CurrentTool" Value="{Binding Drawing.CurrentTool}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- メニュー（仕様 4.2）。InputGestureText は表示だけで、キーの割り当ては Shortcuts.Source が行う -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
            </MenuItem>
            <!-- Edit を開くたびに、クリップボードの内容に合わせて Paste の有効状態を更新する -->
            <MenuItem Header="_Edit" behaviors:CommandEvents.SubmenuOpened="{Binding RefreshClipboardStateCommand}">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                <Separator />
                <MenuItem Header="Copy as _Metafile" Command="{Binding CopyMetafileCommand}" />
                <MenuItem Header="Copy as _Image" Command="{Binding CopyImageCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <!-- 表示状態はコマンドで切り替える。チェックは表示状態を映すだけ（OneWay） -->
                <MenuItem Header="_Properties Window" InputGestureText="F4" Command="{Binding TogglePropertiesCommand}"
                          IsChecked="{Binding IsPropertiesWindowVisible, Mode=OneWay}" />
            </MenuItem>
        </Menu>

        <!-- ツールバー：ツールボタン（排他。ツールは ToolSelection.Tool で指定）と Undo / Redo（仕様 4.2） -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar ClipToBounds="False">
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Select" behaviors:ToolSelection.Tool="Select">
                    <materialDesign:PackIcon Kind="CursorDefault" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Line" behaviors:ToolSelection.Tool="Line">
                    <materialDesign:PackIcon Kind="VectorLine" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Circle" behaviors:ToolSelection.Tool="Circle">
                    <materialDesign:PackIcon Kind="CircleOutline" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Rectangle" behaviors:ToolSelection.Tool="Rectangle">
                    <materialDesign:PackIcon Kind="RectangleOutline" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Polyline" behaviors:ToolSelection.Tool="Polyline">
                    <materialDesign:PackIcon Kind="VectorPolyline" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Polygon" behaviors:ToolSelection.Tool="Polygon">
                    <materialDesign:PackIcon Kind="VectorPolygon" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Open Curve" behaviors:ToolSelection.Tool="OpenCurve">
                    <materialDesign:PackIcon Kind="VectorCurve" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" ToolTip="Closed Curve" behaviors:ToolSelection.Tool="ClosedCurve">
                    <materialDesign:PackIcon Kind="VectorEllipse" />
                </RadioButton>
                <Separator />
                <!-- Edit メニューと同じコマンドにして、有効状態もそろえる（仕様 4.2） -->
                <Button ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}">
                    <materialDesign:PackIcon Kind="Undo" />
                </Button>
                <Button ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}">
                    <materialDesign:PackIcon Kind="Redo" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 状態表示（仕様 4.4）：左から操作案内、カーソルの座標、拡大率。右の 2 つを右端に寄せ、残りの幅を操作案内に充てる -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" MinWidth="100" Content="{Binding Drawing.ZoomText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" MinWidth="180" Content="{Binding Drawing.CursorText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem Content="{Binding Drawing.StatusText}" />
        </StatusBar>

        <!-- 描画領域：DockPanel の最後の子として、残りの領域を埋める -->
        <views:DrawingView DataContext="{Binding Drawing}" />
    </DockPanel>
</Window>
