<UserControl x:Class="Shos.WpfCadSample.Views.DrawingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Shos.WpfCadSample.Models;assembly=Shos.WpfCadSample.Core"
             xmlns:viewModels="clr-namespace:Shos.WpfCadSample.ViewModels;assembly=Shos.WpfCadSample.Core"
             xmlns:converters="clr-namespace:Shos.WpfCadSample.Views.Converters"
             xmlns:views="clr-namespace:Shos.WpfCadSample.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:DrawingViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
    <UserControl.Resources>
        <converters:ShapeToGeometryConverter x:Key="ShapeToGeometry" />
        <converters:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <converters:LineStyleToDashesConverter x:Key="LineStyleToDashes" />
        <converters:ViewTransformToMatrixConverter x:Key="ViewTransformToMatrix" />
        <converters:Rect2ToRectConverter x:Key="Rect2ToRect" />
        <converters:PointerCursorToCursorConverter x:Key="PointerCursorToCursor" />

        <!-- 図形の線：色・太さ（論理座標）・線種は図形の属性から（仕様 3.4、4.0） -->
        <Style x:Key="ShapePath" TargetType="Path">
            <Setter Property="Data" Value="{Binding Converter={StaticResource ShapeToGeometry}}" />
            <Setter Property="Stroke" Value="{Binding Attributes.Color, Converter={StaticResource RgbColorToBrush}}" />
            <Setter Property="StrokeThickness" Value="{Binding Attributes.Thickness}" />
            <Setter Property="StrokeDashArray" Value="{Binding Attributes.LineStyle, Converter={StaticResource LineStyleToDashes}}" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <!-- 図形の種類ごとの DataTemplate（設計書 5.7）。描画は、どれも Outline から作るジオメトリで行う -->
        <DataTemplate DataType="{x:Type models:LineShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:CircleShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:RectangleShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:PolylineShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:PolygonShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:OpenCurveShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:ClosedCurveShape}">
            <Path Style="{StaticResource ShapePath}" />
        </DataTemplate>

        <!-- 論理座標の層：Canvas 全体にビュー変換（拡大率・平行移動・Y 反転）を掛ける（設計書 DD-4） -->
        <ItemsPanelTemplate x:Key="LogicalLayerPanel">
            <Canvas RenderTransform="{Binding Transform, Converter={StaticResource ViewTransformToMatrix}}" />
        </ItemsPanelTemplate>

        <!-- 図形は外接矩形の左下（論理座標）に置く。ジオメトリはそこを原点とする相対座標 -->
        <Style x:Key="ShapeContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Bounds.Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Bounds.Bottom}" />
        </Style>
    </UserControl.Resources>

    <!-- 背景は全体を白にする（仕様 4.3）。テーマには左右されない -->
    <Grid Background="White" ClipToBounds="True">
        <!-- ① 論理領域の枠：線は拡大率に左右されない 1 px の薄い線にするため、変換は Path ではなくジオメトリに掛ける -->
        <Path Stroke="{DynamicResource MaterialDesign.Brush.Separator.Background}" StrokeThickness="1">
            <Path.Data>
                <RectangleGeometry Rect="{Binding LogicalArea, Converter={StaticResource Rect2ToRect}}"
                                   Transform="{Binding Transform, Converter={StaticResource ViewTransformToMatrix}}" />
            </Path.Data>
        </Path>

        <!-- ② 図形（追加順に重ねる） -->
        <ItemsControl ItemsSource="{Binding Shapes}" ItemsPanel="{StaticResource LogicalLayerPanel}"
                      ItemContainerStyle="{StaticResource ShapeContainer}" />

        <!-- ③ 入力中の図形（現在の既定属性で描くプレビュー） -->
        <ItemsControl ItemsSource="{Binding InputShapes}" ItemsPanel="{StaticResource LogicalLayerPanel}"
                      ItemContainerStyle="{StaticResource ShapeContainer}" />

        <!-- ④ 選択ハンドル：画面座標に、拡大率に左右されない 8 px の四角を置く（仕様 A-18） -->
        <ItemsControl ItemsSource="{Binding Handles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:HandleItem}">
                    <Rectangle Width="8" Height="8" Margin="-4,-4,0,0" StrokeThickness="1"
                               Fill="{DynamicResource MaterialDesign.Brush.Background}"
                               Stroke="{DynamicResource MaterialDesign.Brush.Primary}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ⑤ 入力を受ける面（マウス、ホイール、描画領域の大きさ）。カーソルの形は仕様 4.3 -->
        <views:DrawingSurface PointerCommand="{Binding PointerCommand}" PointerLeaveCommand="{Binding PointerLeaveCommand}"
                              ZoomCommand="{Binding ZoomCommand}" ViewSizeCommand="{Binding SetViewSizeCommand}"
                              Cursor="{Binding Cursor, Converter={StaticResource PointerCursorToCursor}}" />
    </Grid>
</UserControl>
