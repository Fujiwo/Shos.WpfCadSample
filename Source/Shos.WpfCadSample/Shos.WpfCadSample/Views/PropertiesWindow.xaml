<Window x:Class="Shos.WpfCadSample.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:Shos.WpfCadSample.Models;assembly=Shos.WpfCadSample.Core"
        xmlns:viewModels="clr-namespace:Shos.WpfCadSample.ViewModels;assembly=Shos.WpfCadSample.Core"
        xmlns:settings="clr-namespace:Shos.WpfCadSample.Settings;assembly=Shos.WpfCadSample.Core"
        xmlns:converters="clr-namespace:Shos.WpfCadSample.Views.Converters"
        xmlns:behaviors="clr-namespace:Shos.WpfCadSample.Views.Behaviors"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        DataContext="{Binding MainViewModel, Source={StaticResource CompositionRoot}}"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Properties" Width="300" Height="520" ShowInTaskbar="False"
        behaviors:WindowVisibilityBehavior.IsShown="{Binding IsPropertiesWindowVisible}"
        behaviors:WindowPlacementBehavior.Placement="{Binding PropertiesPlacement}"
        behaviors:WindowPlacementBehavior.DefaultPlacement="{Binding PropertiesWindow.Placement, Source={x:Static settings:AppSettings.Default}}"
        behaviors:Shortcuts.Source="{StaticResource MenuShortcuts}"
        behaviors:CommandEvents.Activated="{Binding RefreshClipboardStateCommand}">
    <Window.Resources>
        <converters:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- 不正な入力は反映せず、入力部品を検証エラーの見た目で示す（仕様 5.4） -->
        <Style x:Key="InvalidInput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <system:Boolean>False</system:Boolean>
                    </Trigger.Value>
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 属性の編集部品：色（見本、16 進、RGB スライダー）、太さ、線種。「Selected Shape」と「Defaults for New Shapes」で共有する -->
        <DataTemplate x:Key="AttributeEditor" DataType="{x:Type viewModels:AttributeEditModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Minimum" Value="0" />
                        <Setter Property="Maximum" Value="255" />
                        <Setter Property="SmallChange" Value="1" />
                        <Setter Property="LargeChange" Value="16" />
                        <Setter Property="IsSnapToTickEnabled" Value="True" />
                        <Setter Property="TickFrequency" Value="1" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="behaviors:EditCommit.Command" Value="{Binding DataContext.Properties.CommitEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Color" />
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0" BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                            Background="{Binding Attributes.Color, Converter={StaticResource RgbColorToBrush}}" />
                    <TextBox Width="96" Style="{StaticResource InvalidInput}" materialDesign:HintAssist.Hint="#RRGGBB"
                             Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding IsHexValid}"
                             behaviors:EditCommit.Command="{Binding DataContext.Properties.CommitEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="R" HorizontalAlignment="Right" />
                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Red}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Red}" HorizontalAlignment="Right" Margin="0" />
                <TextBlock Grid.Row="2" Text="G" HorizontalAlignment="Right" />
                <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Green}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Green}" HorizontalAlignment="Right" Margin="0" />
                <TextBlock Grid.Row="3" Text="B" HorizontalAlignment="Right" />
                <Slider Grid.Row="3" Grid.Column="1" Value="{Binding Blue}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Blue}" HorizontalAlignment="Right" Margin="0" />

                <TextBlock Grid.Row="4" Text="Thickness" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Style="{StaticResource InvalidInput}"
                         materialDesign:HintAssist.Hint="0.5 - 50"
                         Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding IsThicknessValid}"
                         behaviors:EditCommit.Command="{Binding DataContext.Properties.CommitEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Grid.Row="5" Text="Line style" />
                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                          ItemsSource="{x:Static viewModels:AttributeEditModel.LineStyles}" SelectedItem="{Binding LineStyle}"
                          behaviors:EditCommit.Command="{Binding DataContext.Properties.CommitEditCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LineStyle}">
                            <TextBlock x:Name="Name" Text="{Binding}" Margin="0" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static models:LineStyle.DashDot}">
                                    <Setter TargetName="Name" Property="Text" Value="Dash-Dot" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <!-- 選択がなければ、値を空欄にして無効にする（仕様 4.5） -->
            <materialDesign:Card Padding="12" Margin="0,0,0,8" IsEnabled="{Binding Properties.HasSelection}">
                <StackPanel>
                    <TextBlock Text="Selected Shape" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Type" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Properties.ShapeTypeName}" />
                    </StackPanel>
                    <ContentControl Content="{Binding Properties.SelectedAttributes}" ContentTemplate="{StaticResource AttributeEditor}" Focusable="False"
                                    Visibility="{Binding Properties.HasSelection, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="12">
                <StackPanel>
                    <TextBlock Text="Defaults for New Shapes" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" Margin="0,0,0,8" />
                    <ContentControl Content="{Binding Properties.DefaultAttributes}" ContentTemplate="{StaticResource AttributeEditor}" Focusable="False" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Window>
